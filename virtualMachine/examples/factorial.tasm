; Compute 5! = 120
    PUSH 5
    STORE 0          ; n = 5
    PUSH 1
    STORE 1          ; result = 1
loop:
    LOAD 0
    JZ done
    LOAD 1
    LOAD 0
    MUL
    STORE 1          ; result *= n
    LOAD 0
    PUSH 1
    SUB
    STORE 0          ; n--
    JMP loop
done:
    LOAD 1
    PRINT
    HALT
